{
  "manifest_version": 3,
  "name": "Movie Rating Sync",
  "name:ru": "Синхронизация Кинооценок",
  "version": "1.11",
  "description": "Move your movie ratings between Kinopoisk, IMDb and Letterboxd as a CSV file.",
  "description:ru": "Переносите оценки фильмов между Кинопоиском, IMDb и Letterboxd через CSV-файл.",
  "author": "Smokelweiss",
  "homepage_url": "https://github.com/Smokelweiss/MovieRatingSync",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kinopoisk.ru/*",
        "https://www.imdb.com/*",
        "https://letterboxd.com/*"
      ],
      "js": ["content-bootstrap.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.kinopoisk.ru/*",
    "https://graphql.kinopoisk.ru/*",
    "https://www.imdb.com/*",
    "https://api.graphql.imdb.com/*",
    "https://sg.media-imdb.com/*",
    "https://letterboxd.com/*"
  ],
  "permissions": ["storage"]
}
