{
  "manifest_version": 3,
  "name": "Movie Rating Sync",
  "description": "Sync movie ratings across Kinopoisk, IMDb, Letterboxd and more",
  "version": "1.2",
  "author": "Smokelweiss",
  "homepage_url": "https://github.com/Smokelweiss/MovieRatingSync",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.kinopoisk.ru/*",
    "https://graphql.kinopoisk.ru/*",
    "*://*.imdb.com/*",
    "https://sg.media-imdb.com/*",
    "*://*.letterboxd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.kinopoisk.ru/*",
        "*://www.imdb.com/*",
        "*://letterboxd.com/*"
      ],
      "js": [
        "content-bootstrap.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "*://www.kinopoisk.ru/*",
        "*://www.imdb.com/*",
        "*://letterboxd.com/*"
      ]
    }
  ]
}
